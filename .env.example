# Copy to .env and set a key from your own OpenAI API project.
OPENAI_API_KEY=
# Optional model default for newly created agents.
OPENAI_MODEL=
OPENAI_IMAGE_MODEL=gpt-image-1

# For Docker with HTTPS and workspace login.
# Example for Docker: https://agentsim.example.com
AGENTSIM_PUBLIC_URL=
AGENTSIM_HTTP_PORT=8080
